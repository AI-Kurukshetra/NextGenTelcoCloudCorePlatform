{
  "name": "ngcmcp-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "echo \"No tests configured\"",
    "db:migrate": "npx tsx scripts/migrate-db.ts",
    "db:seed": "npx tsx scripts/seed-db.ts",
    "db:setup": "npm run db:migrate && echo '✅ Setup complete'",
    "db:setup:full": "npm run db:migrate && npm run db:seed-demo-users && echo '✅ Full setup: migrations, seed, demo users complete'",
    "db:simulate": "npx tsx scripts/simulate-live-data.ts",
    "db:simulate:cron": "npx tsx scripts/simulate-live-data.ts --once",
    "db:seed-demo-users": "npx tsx scripts/seed-demo-users.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.1",
    "dotenv": "^17.3.1",
    "next": "16.1.6",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
